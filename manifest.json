{
  "manifest_version": 3,
  "name": "SpanishDict to Anki Exporter",
  "version": "1.0.0",
  "description": "Export SpanishDict vocabulary lists into Anki via the local AnkiConnect API.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*", "https://www.spanishdict.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SpanishDict to Anki Exporter",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
